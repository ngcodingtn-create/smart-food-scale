# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
#   cp .env.example .env
#
# Every setting is optional; the defaults run the whole backend offline with the
# stub recogniser and the local Tunisian table.

# ---- Recognition -------------------------------------------------------------
# Which recogniser implementation to use:
#   stub    offline and deterministic: the same photo always gives the same dish.
#           Not recognition. The default.
#   gemini  Google's Gemini looks at the photo and picks one of our dishes, or
#           says it does not know. Needs the key below.
SFS_RECOGNISER=stub

# Gemini key: create one in Google AI Studio (https://aistudio.google.com/apikey).
# Paste it here and nowhere else. On the free tier Google may use the photos to
# improve its products.
SFS_GEMINI_API_KEY=
# Google's model page (2026-10-23) recommends 3.5 Flash-Lite or 3.8 Flash for new
# projects. Flash-Lite has the larger free allowance.
# SFS_GEMINI_MODEL=gemini-3.5-flash-lite
# Below this self-reported confidence the answer is "unknown". A starting value.
# SFS_GEMINI_MIN_CONFIDENCE=0.5

# ---- Nutrition ---------------------------------------------------------------
# USDA FoodData Central. Free key from https://fdc.nal.usda.gov/api-key-signup.html
# Rate limit is 1,000 requests/hour per api.data.gov key, so responses are cached
# on disk by fdcId. Leave USDA disabled to keep the backend fully offline.
SFS_USDA_ENABLED=false
SFS_USDA_API_KEY=

# ---- Storage -----------------------------------------------------------------
# SQLite by default. Point at Postgres if the team ever needs concurrent writers.
# SFS_DATABASE_URL=sqlite:///./smart_food_scale.db

# ---- Limits ------------------------------------------------------------------
# Reject an implausible mass as a sensor fault rather than a real plate of food.
# 5000 g is four times a large restaurant portion and past the 3 kg cell's safe overload.
SFS_MAX_GRAMS=5000

# Largest JPEG the ESP32-CAM is allowed to post, in bytes.
SFS_MAX_IMAGE_BYTES=8388608

# Keep the uploaded JPEG on disk after processing. Off by default: the device can
# post a photo every few seconds and the disk fills quietly.
SFS_STORE_IMAGES=false
