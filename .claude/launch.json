{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "url": "http://localhost:3000"
    },
    {
      "name": "web-start",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "app.main:app",
        "--app-dir", "backend",
        "--reload", "--reload-dir", "backend/app",
        "--port", "8000"
      ],
      "port": 8000
    },
    {
      "name": "backend-lan",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m", "uvicorn", "app.main:app",
        "--app-dir", "backend",
        "--host", "0.0.0.0",
        "--port", "8000"
      ],
      "port": 8000
    }
  ]
}
